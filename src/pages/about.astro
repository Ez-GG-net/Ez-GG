---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About Ez-GG and it's mission.">
  <section class="project-page">
    <p class="eyebrow">About</p>
    <h1>Our team</h1>
    <p class="intro">
      Ez-GG is a polished project hub for browser games, AI experiments, simulations, and utility tools.
    </p>
    <a class="button-secondary" href="/contact">
      <i class="fa-solid fa-user"></i>
      Contact us
    </a>
  </section>

  <section class="section reveal">
    <div class="grid cards-1">
      <div class="category-link">
        <span class="card-badge">Founder</span>
        <h3>Shawn Kurien</h3>
        <p>
          Founded Ez-GG and guides its vision, direction, and long-term development.
        </p>
      </div>
      <div class="category-link">
        <span class="card-badge">Lead Developer</span>
        <h3>Shawn Kurien</h3>
        <p>
          Builds and maintains the platform, developing features, tools, and technical infrastructure
        </p>
      </div>
      <div class="category-link">
        <span class="card-badge">Lead Designer</span>
        <h3>Shawn Kurien</h3>
        <p>
          Responsible for the overall design of the website, including the user interface and user experience.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
