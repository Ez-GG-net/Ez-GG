---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Suggest any feedback or requests and we will get back to you">
  <section class="project-page">
    <p class="eyebrow">Contact us</p>
    <h1>Contact our team</h1>
    <p class="intro">
      Suggest any feedback or requests and we will get back to you as soon as possible.
    </p>
  </section>

  <section class="section reveal">
    <div class="grid cards-2">
      <div class="category-link">
        <span class="card-badge">Email</span>
        <h3>Email us for issues or feedback</h3>
        <p>
          <strong>contact@ez-gg.net</strong>
        </p>
      </div>
      <div class="category-link">
        <span class="card-badge">Github</span>
        <h3>Find us on Github</h3>
            <p>
              <strong>github.com/Ez-GG</strong>
            </p>
      </div>
    </div>
  </section>
</BaseLayout>
